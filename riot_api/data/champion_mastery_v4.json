{
  "openapi": "3.0.0",
  "info": {
    "title": "Riot API - CHAMPION-MASTERY-V4",
    "version": "1.0.0",
    "description": "플레이어의 챔피언 숙련도 정보를 조회하는 Riot Games API (CHAMPION-MASTERY-V4)"
  },
  "tags": [
    { "name": "CHAMPION-MASTERY-V4", "description": "Riot 챔피언 숙련도 관련 API" }
  ],
  "paths": {
    "/lol/champion-mastery/v4/champion-masteries/by-puuid/{encryptedPUUID}": {
      "get": {
        "tags": ["CHAMPION-MASTERY-V4"],
        "summary": "플레이어의 전체 챔피언 숙련도 목록 조회",
        "description": "지정된 플레이어의 모든 챔피언 숙련도 정보를 숙련도 포인트 내림차순으로 반환합니다.",
        "parameters": [
          {
            "name": "encryptedPUUID",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "암호화된 플레이어 PUUID (78자)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of ChampionMasteryDto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChampionMasteryDto" }
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "405": { "description": "Method not allowed" },
          "415": { "description": "Unsupported media type" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" },
          "502": { "description": "Bad gateway" },
          "503": { "description": "Service unavailable" },
          "504": { "description": "Gateway timeout" }
        }
      }
    },
    "/lol/champion-mastery/v4/champion-masteries/by-puuid/{encryptedPUUID}/by-champion/{championId}": {
      "get": {
        "tags": ["CHAMPION-MASTERY-V4"],
        "summary": "특정 챔피언의 숙련도 조회",
        "description": "PUUID와 챔피언 ID를 이용해 특정 챔피언의 숙련도 정보를 반환합니다.",
        "parameters": [
          {
            "name": "encryptedPUUID",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "암호화된 플레이어 PUUID (78자)"
          },
          {
            "name": "championId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "챔피언 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "ChampionMasteryDto",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChampionMasteryDto" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/champion-mastery/v4/champion-masteries/by-puuid/{encryptedPUUID}/top": {
      "get": {
        "tags": ["CHAMPION-MASTERY-V4"],
        "summary": "상위 챔피언 숙련도 조회",
        "description": "플레이어의 숙련도 포인트 상위 N개의 챔피언 정보를 반환합니다.",
        "parameters": [
          {
            "name": "encryptedPUUID",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "암호화된 플레이어 PUUID"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 3 },
            "description": "조회할 챔피언 개수 (기본값: 3)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of ChampionMasteryDto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChampionMasteryDto" }
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/champion-mastery/v4/scores/by-puuid/{encryptedPUUID}": {
      "get": {
        "tags": ["CHAMPION-MASTERY-V4"],
        "summary": "총 숙련도 점수 조회",
        "description": "플레이어의 전체 챔피언 숙련도 점수(각 챔피언 숙련도 레벨의 합)를 반환합니다.",
        "parameters": [
          {
            "name": "encryptedPUUID",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "암호화된 플레이어 PUUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Total champion mastery score (integer)",
            "content": {
              "application/json": {
                "schema": { "type": "integer", "example": 354 }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChampionMasteryDto": {
        "type": "object",
        "description": "플레이어와 챔피언 조합에 대한 숙련도 정보 객체",
        "properties": {
          "puuid": { "type": "string", "description": "플레이어의 암호화된 PUUID (78자)" },
          "championId": { "type": "integer", "description": "챔피언 ID" },
          "championLevel": { "type": "integer", "description": "플레이어의 해당 챔피언 숙련도 레벨" },
          "championPoints": { "type": "integer", "description": "플레이어의 총 숙련도 포인트" },
          "championPointsUntilNextLevel": { "type": "integer", "description": "다음 레벨까지 필요한 포인트 (최대 레벨일 경우 0)" },
          "championPointsSinceLastLevel": { "type": "integer", "description": "현재 레벨 달성 후 획득한 포인트" },
          "chestGranted": { "type": "boolean", "description": "해당 시즌에 상자 획득 여부" },
          "lastPlayTime": { "type": "integer", "description": "해당 챔피언 마지막 플레이 시각 (Unix 밀리초)" },
          "markRequiredForNextLevel": { "type": "integer", "description": "다음 레벨 달성에 필요한 마크 수" },
          "championSeasonMilestone": { "type": "integer", "description": "현재 시즌 챔피언 마일스톤" },
          "tokensEarned": { "type": "integer", "description": "현재 숙련도 단계에서 획득한 토큰 수 (레벨 업 시 초기화)" },
          "milestoneGrades": {
            "type": "array",
            "items": { "type": "string" },
            "description": "마일스톤 등급 목록"
          },
          "nextSeasonMilestone": {
            "$ref": "#/components/schemas/NextSeasonMilestonesDto",
            "description": "다음 시즌 마일스톤 정보"
          }
        },
        "example": {
          "puuid": "abcd1234efgh5678ijkl",
          "championId": 67,
          "championLevel": 6,
          "championPoints": 51234,
          "chestGranted": true,
          "lastPlayTime": 1729582390000,
          "tokensEarned": 2
        }
      },
      "NextSeasonMilestonesDto": {
        "type": "object",
        "description": "다음 시즌 마일스톤 관련 정보",
        "properties": {
          "requireGradeCounts": {
            "type": "object",
            "description": "등급별 요구 횟수 정보 (예: S, A 등)"
          },
          "rewardMarks": { "type": "integer", "description": "보상 마크 수" },
          "bonus": { "type": "boolean", "description": "보너스 여부" },
          "rewardConfig": {
            "$ref": "#/components/schemas/RewardConfigDto",
            "description": "보상 구성 정보"
          }
        }
      },
      "RewardConfigDto": {
        "type": "object",
        "description": "보상 구성 정보 객체",
        "properties": {
          "rewardValue": { "type": "string", "description": "보상 값" },
          "rewardType": { "type": "string", "description": "보상 유형" },
          "maximumReward": { "type": "integer", "description": "최대 보상 수" }
        }
      }
    }
  }
}
