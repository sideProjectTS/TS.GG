{
  "openapi": "3.0.0",
  "info": {
    "title": "Riot API - LEAGUE-V4",
    "version": "1.0.0",
    "description": "리그 오브 레전드의 리그(랭크) 정보 API 명세입니다.\n챌린저, 그랜드마스터, 마스터, 일반 리그, 특정 플레이어 랭크 정보를 조회할 수 있습니다."
  },
  "tags": [
    { "name": "LEAGUE-V4", "description": "리그 오브 레전드 랭크 관련 API 엔드포인트" }
  ],
  "paths": {
    "/lol/league/v4/challengerleagues/by-queue/{queue}": {
      "get": {
        "tags": ["LEAGUE-V4"],
        "summary": "챌린저 리그 조회",
        "description": "특정 큐 타입의 챌린저 리그 정보를 조회합니다.",
        "parameters": [
          {
            "name": "queue",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "랭크 큐 타입 (예: RANKED_SOLO_5x5)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeagueListDTO" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/league/v4/grandmasterleagues/by-queue/{queue}": {
      "get": {
        "tags": ["LEAGUE-V4"],
        "summary": "그랜드마스터 리그 조회",
        "description": "특정 큐 타입의 그랜드마스터 리그 정보를 조회합니다.",
        "parameters": [
          {
            "name": "queue",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "랭크 큐 타입 (예: RANKED_SOLO_5x5)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeagueListDTO" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/league/v4/masterleagues/by-queue/{queue}": {
      "get": {
        "tags": ["LEAGUE-V4"],
        "summary": "마스터 리그 조회",
        "description": "특정 큐 타입의 마스터 리그 정보를 조회합니다.",
        "parameters": [
          {
            "name": "queue",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "랭크 큐 타입 (예: RANKED_SOLO_5x5)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeagueListDTO" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/league/v4/leagues/{leagueId}": {
      "get": {
        "tags": ["LEAGUE-V4"],
        "summary": "리그 ID로 리그 정보 조회",
        "description": "특정 리그 ID로 해당 리그의 세부 정보를 조회합니다.",
        "parameters": [
          {
            "name": "leagueId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "리그의 UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeagueListDTO" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/league/v4/entries/by-puuid/{encryptedPUUID}": {
      "get": {
        "tags": ["LEAGUE-V4"],
        "summary": "PUUID로 플레이어 리그 정보 조회",
        "description": "특정 플레이어(PUUID 기준)의 모든 큐 타입 리그 정보를 조회합니다.",
        "parameters": [
          {
            "name": "encryptedPUUID",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "플레이어의 암호화된 PUUID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LeagueEntryDTO" }
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/league/v4/entries/{queue}/{tier}/{division}": {
      "get": {
        "tags": ["LEAGUE-V4"],
        "summary": "리그 엔트리 조회",
        "description": "큐 타입, 티어, 디비전 기준으로 해당 리그의 모든 플레이어 랭킹 정보를 조회합니다.",
        "parameters": [
          { "name": "queue", "in": "path", "required": true, "schema": { "type": "string" }, "description": "랭크 큐 타입" },
          { "name": "tier", "in": "path", "required": true, "schema": { "type": "string" }, "description": "리그 티어 (예: GOLD, PLATINUM)" },
          { "name": "division", "in": "path", "required": true, "schema": { "type": "string" }, "description": "디비전 (예: I, II, III, IV)" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 }, "description": "페이지 번호 (기본값: 1)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LeagueEntryDTO" }
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LeagueListDTO": {
        "type": "object",
        "description": "리그 목록 정보 객체",
        "properties": {
          "leagueId": { "type": "string", "description": "리그 ID" },
          "entries": { "type": "array", "description": "리그 내 플레이어 엔트리 목록", "items": { "$ref": "#/components/schemas/LeagueItemDTO" } },
          "tier": { "type": "string", "description": "리그 티어 (예: CHALLENGER, MASTER 등)" },
          "name": { "type": "string", "description": "리그 이름" },
          "queue": { "type": "string", "description": "랭크 큐 타입" }
        }
      },
      "LeagueItemDTO": {
        "type": "object",
        "description": "리그 플레이어 엔트리 정보 객체",
        "properties": {
          "freshBlood": { "type": "boolean", "description": "새로운 참가자 여부" },
          "wins": { "type": "integer", "description": "승리 횟수" },
          "miniSeries": { "$ref": "#/components/schemas/MiniSeriesDTO" },
          "inactive": { "type": "boolean", "description": "비활성화 여부" },
          "veteran": { "type": "boolean", "description": "베테랑 여부" },
          "hotStreak": { "type": "boolean", "description": "연승 여부" },
          "rank": { "type": "string", "description": "디비전 (예: I, II, III, IV)" },
          "leaguePoints": { "type": "integer", "description": "리그 포인트 (LP)" },
          "losses": { "type": "integer", "description": "패배 횟수" },
          "puuid": { "type": "string", "description": "플레이어의 암호화된 PUUID" }
        }
      },
      "LeagueEntryDTO": {
        "type": "object",
        "description": "플레이어 리그 엔트리 정보 객체",
        "properties": {
          "leagueId": { "type": "string", "description": "리그 ID" },
          "puuid": { "type": "string", "description": "플레이어의 암호화된 PUUID" },
          "queueType": { "type": "string", "description": "랭크 큐 타입" },
          "tier": { "type": "string", "description": "리그 티어" },
          "rank": { "type": "string", "description": "디비전 (예: I, II, III, IV)" },
          "leaguePoints": { "type": "integer", "description": "리그 포인트 (LP)" },
          "wins": { "type": "integer", "description": "승리 횟수" },
          "losses": { "type": "integer", "description": "패배 횟수" },
          "hotStreak": { "type": "boolean", "description": "연승 여부" },
          "veteran": { "type": "boolean", "description": "베테랑 여부" },
          "freshBlood": { "type": "boolean", "description": "새로운 플레이어 여부" },
          "inactive": { "type": "boolean", "description": "비활성화 여부" },
          "miniSeries": { "$ref": "#/components/schemas/MiniSeriesDTO" }
        }
      },
      "MiniSeriesDTO": {
        "type": "object",
        "description": "승급전(시리즈) 정보 객체",
        "properties": {
          "losses": { "type": "integer", "description": "패배 횟수" },
          "progress": { "type": "string", "description": "진행 상태 (예: WLW)" },
          "target": { "type": "integer", "description": "필요한 승리 횟수" },
          "wins": { "type": "integer", "description": "승리 횟수" }
        }
      }
    }
  }
}
