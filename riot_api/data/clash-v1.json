{
  "openapi": "3.0.0",
  "info": {
    "title": "Riot API - CLASH-V1",
    "version": "1.0.0",
    "description": "리그 오브 레전드의 Clash(팀 토너먼트) 관련 API 명세입니다.\n플레이어, 팀, 토너먼트 정보를 조회할 수 있습니다."
  },
  "tags": [
    { "name": "CLASH-V1", "description": "LoL Clash 토너먼트 관련 API 엔드포인트" }
  ],
  "paths": {
    "/lol/clash/v1/players/by-puuid/{puuid}": {
      "get": {
        "tags": ["CLASH-V1"],
        "summary": "PUUID로 플레이어 Clash 정보 조회",
        "description": "특정 플레이어가 등록한 Clash 팀 목록을 조회합니다.",
        "parameters": [
          {
            "name": "puuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "플레이어의 암호화된 PUUID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PlayerDto" }
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/clash/v1/teams/{teamId}": {
      "get": {
        "tags": ["CLASH-V1"],
        "summary": "팀 ID로 팀 정보 조회",
        "description": "특정 팀의 Clash 정보를 조회합니다. (팀명, 팀장, 멤버 등)",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "팀의 고유 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TeamDto" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/clash/v1/tournaments": {
      "get": {
        "tags": ["CLASH-V1"],
        "summary": "활성 또는 예정된 토너먼트 목록 조회",
        "description": "현재 진행 중이거나 예정된 Clash 토너먼트 목록을 반환합니다.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TournamentDto" }
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/clash/v1/tournaments/by-team/{teamId}": {
      "get": {
        "tags": ["CLASH-V1"],
        "summary": "팀 ID로 해당 토너먼트 조회",
        "description": "특정 팀이 참가 중인 Clash 토너먼트 정보를 반환합니다.",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "팀의 고유 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TournamentDto" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/clash/v1/tournaments/{tournamentId}": {
      "get": {
        "tags": ["CLASH-V1"],
        "summary": "토너먼트 ID로 상세 정보 조회",
        "description": "특정 토너먼트의 세부 정보(단계, 일정 등)를 조회합니다.",
        "parameters": [
          {
            "name": "tournamentId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "토너먼트 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TournamentDto" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlayerDto": {
        "type": "object",
        "description": "Clash 플레이어 정보 객체",
        "properties": {
          "puuid": { "type": "string", "description": "플레이어 PUUID" },
          "teamId": { "type": "string", "description": "소속 팀 ID" },
          "position": { "type": "string", "description": "플레이어 포지션 (UNSELECTED, FILL, TOP, JUNGLE, MIDDLE, BOTTOM, UTILITY)" },
          "role": { "type": "string", "description": "팀 내 역할 (CAPTAIN, MEMBER)" }
        },
        "example": {
          "puuid": "abcd1234efgh5678ijkl",
          "teamId": "TEAM123",
          "position": "TOP",
          "role": "CAPTAIN"
        }
      },
      "TeamDto": {
        "type": "object",
        "description": "Clash 팀 정보 객체",
        "properties": {
          "id": { "type": "string", "description": "팀 ID" },
          "tournamentId": { "type": "integer", "description": "참가 중인 토너먼트 ID" },
          "name": { "type": "string", "description": "팀 이름" },
          "iconId": { "type": "integer", "description": "팀 아이콘 ID" },
          "tier": { "type": "integer", "description": "팀 티어" },
          "captain": { "type": "string", "description": "팀장 소환사 ID" },
          "abbreviation": { "type": "string", "description": "팀 약어" },
          "players": {
            "type": "array",
            "description": "팀 멤버 목록",
            "items": { "$ref": "#/components/schemas/PlayerDto" }
          }
        },
        "example": {
          "id": "TEAM123",
          "tournamentId": 1001,
          "name": "KRWolves",
          "iconId": 3,
          "tier": 2,
          "captain": "abcd1234efgh5678",
          "abbreviation": "KRW",
          "players": [{ "puuid": "abcd1234", "position": "TOP", "role": "CAPTAIN" }]
        }
      },
      "TournamentDto": {
        "type": "object",
        "description": "Clash 토너먼트 정보 객체",
        "properties": {
          "id": { "type": "integer", "description": "토너먼트 ID" },
          "themeId": { "type": "integer", "description": "토너먼트 테마 ID" },
          "nameKey": { "type": "string", "description": "토너먼트 이름 키" },
          "nameKeySecondary": { "type": "string", "description": "보조 이름 키" },
          "schedule": {
            "type": "array",
            "description": "토너먼트 단계(페이즈) 목록",
            "items": { "$ref": "#/components/schemas/TournamentPhaseDto" }
          }
        },
        "example": {
          "id": 101,
          "themeId": 22,
          "nameKey": "CLASH_WINTER",
          "nameKeySecondary": "KR_2025",
          "schedule": [{ "id": 1, "registrationTime": 1730000000, "startTime": 1730003600, "cancelled": false }]
        }
      },
      "TournamentPhaseDto": {
        "type": "object",
        "description": "토너먼트 단계(페이즈) 정보",
        "properties": {
          "id": { "type": "integer", "description": "단계 ID" },
          "registrationTime": { "type": "integer", "description": "등록 시작 시간 (UNIX ms)" },
          "startTime": { "type": "integer", "description": "토너먼트 시작 시간 (UNIX ms)" },
          "cancelled": { "type": "boolean", "description": "취소 여부" }
        },
        "example": {
          "id": 1,
          "registrationTime": 1730000000,
          "startTime": 1730003600,
          "cancelled": false
        }
      }
    }
  }
}
