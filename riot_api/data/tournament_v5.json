{
  "openapi": "3.0.0",
  "info": {
    "title": "Riot API - TOURNAMENT-V5",
    "version": "1.0.0",
    "description": "Riot Games 공식 토너먼트 생성 및 관리 API입니다.\n실제 게임 서버에서 진행되는 토너먼트 매치를 생성하고, 코드 기반으로 경기 결과 및 이벤트를 조회할 수 있습니다."
  },
  "tags": [
    { "name": "TOURNAMENT-V5", "description": "리그 오브 레전드 공식 토너먼트 운영 API" }
  ],
  "paths": {
    "/lol/tournament/v5/providers": {
      "post": {
        "tags": ["TOURNAMENT-V5"],
        "summary": "토너먼트 Provider 등록",
        "description": "API Key를 사용하여 토너먼트 제공자(Provider)를 등록합니다. 등록된 providerId는 이후 토너먼트 생성 시 필요합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProviderRegistrationParametersV5" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "등록 성공 (providerId 반환)",
            "content": { "application/json": { "schema": { "type": "integer" } } }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/tournament/v5/tournaments": {
      "post": {
        "tags": ["TOURNAMENT-V5"],
        "summary": "토너먼트 생성",
        "description": "Provider ID를 기반으로 실제 게임용 토너먼트를 생성합니다. 반환된 tournamentId를 코드 생성에 사용합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TournamentRegistrationParametersV5" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "토너먼트 생성 성공 (tournamentId 반환)",
            "content": { "application/json": { "schema": { "type": "integer" } } }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/tournament/v5/codes": {
      "post": {
        "tags": ["TOURNAMENT-V5"],
        "summary": "토너먼트 코드 생성",
        "description": "주어진 토너먼트 ID에 대해 실제 매치 생성용 토너먼트 코드를 생성합니다. 한 번에 최대 1000개까지 생성 가능합니다.",
        "parameters": [
          { "name": "tournamentId", "in": "query", "required": true, "schema": { "type": "integer" }, "description": "토너먼트 ID" },
          { "name": "count", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "생성할 코드 개수 (최대 1000)" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TournamentCodeParametersV5" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "코드 생성 성공 (코드 문자열 배열 반환)",
            "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/tournament/v5/codes/{tournamentCode}": {
      "get": {
        "tags": ["TOURNAMENT-V5"],
        "summary": "토너먼트 코드 정보 조회",
        "description": "토너먼트 코드 문자열을 이용하여 실제 매치 정보를 조회합니다.",
        "parameters": [
          { "name": "tournamentCode", "in": "path", "required": true, "schema": { "type": "string" }, "description": "토너먼트 코드 문자열" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TournamentCodeV5DTO" } } } },
          "404": { "description": "Data not found" }
        }
      },
      "put": {
        "tags": ["TOURNAMENT-V5"],
        "summary": "토너먼트 코드 정보 수정",
        "description": "기존 토너먼트 코드의 map, pick, spectator, 참가자 정보를 업데이트합니다.",
        "parameters": [
          { "name": "tournamentCode", "in": "path", "required": true, "schema": { "type": "string" }, "description": "업데이트할 토너먼트 코드" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TournamentCodeUpdateParametersV5" }
            }
          }
        },
        "responses": {
          "204": { "description": "Update successful (No content)" },
          "400": { "description": "Bad request" },
          "404": { "description": "Data not found" }
        }
      }
    },
    "/lol/tournament/v5/games/by-code/{tournamentCode}": {
      "get": {
        "tags": ["TOURNAMENT-V5"],
        "summary": "토너먼트 경기 상세 조회",
        "description": "토너먼트 코드로 생성된 실제 경기 정보를 조회합니다. 이 엔드포인트는 PUUID 포함 매치 데이터를 반환합니다.",
        "parameters": [
          { "name": "tournamentCode", "in": "path", "required": true, "schema": { "type": "string" }, "description": "토너먼트 코드" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TournamentGamesV5" } } }
            }
          },
          "404": { "description": "Data not found" }
        }
      }
    },
    "/lol/tournament/v5/lobby-events/by-code/{tournamentCode}": {
      "get": {
        "tags": ["TOURNAMENT-V5"],
        "summary": "로비 이벤트 조회",
        "description": "특정 토너먼트 코드에 대해 로비 이벤트 내역을 반환합니다.",
        "parameters": [
          { "name": "tournamentCode", "in": "path", "required": true, "schema": { "type": "string" }, "description": "토너먼트 코드" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LobbyEventV5DTOWrapper" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderRegistrationParametersV5": {
        "type": "object",
        "properties": {
          "region": { "type": "string", "description": "운영 지역 (예: KR, NA, EUW, JP 등)" },
          "url": { "type": "string", "description": "경기 결과 콜백 URL (HTTP/HTTPS)" }
        }
      },
      "TournamentRegistrationParametersV5": {
        "type": "object",
        "properties": {
          "providerId": { "type": "integer", "description": "등록된 provider ID" },
          "name": { "type": "string", "description": "토너먼트 이름 (선택사항)" }
        }
      },
      "TournamentCodeParametersV5": {
        "type": "object",
        "properties": {
          "allowedParticipants": { "type": "array", "items": { "type": "string" }, "description": "참가자 PUUID 목록" },
          "enoughPlayers": { "type": "boolean", "description": "팀 인원 충족 여부" },
          "mapType": { "type": "string", "description": "맵 타입 (SUMMONERS_RIFT, HOWLING_ABYSS 등)" },
          "metadata": { "type": "string", "description": "임의의 메타데이터" },
          "pickType": { "type": "string", "description": "픽 타입 (BLIND_PICK, DRAFT_MODE, ALL_RANDOM, TOURNAMENT_DRAFT)" },
          "spectatorType": { "type": "string", "description": "관전 설정 (NONE, LOBBYONLY, ALL)" },
          "teamSize": { "type": "integer", "description": "팀 크기 (1~5)" }
        }
      },
      "TournamentCodeUpdateParametersV5": {
        "type": "object",
        "properties": {
          "allowedParticipants": { "type": "array", "items": { "type": "string" } },
          "pickType": { "type": "string" },
          "mapType": { "type": "string" },
          "spectatorType": { "type": "string" }
        }
      },
      "TournamentCodeV5DTO": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "providerId": { "type": "integer" },
          "tournamentId": { "type": "integer" },
          "code": { "type": "string" },
          "region": { "type": "string" },
          "map": { "type": "string" },
          "teamSize": { "type": "integer" },
          "spectators": { "type": "string" },
          "pickType": { "type": "string" },
          "lobbyName": { "type": "string" },
          "password": { "type": "string" },
          "metaData": { "type": "string" },
          "participants": { "type": "array", "items": { "type": "string" } }
        }
      },
      "TournamentGamesV5": {
        "type": "object",
        "properties": {
          "startTime": { "type": "integer" },
          "winningTeam": { "type": "array", "items": { "$ref": "#/components/schemas/TournamentTeamV5" } },
          "losingTeam": { "type": "array", "items": { "$ref": "#/components/schemas/TournamentTeamV5" } },
          "shortCode": { "type": "string" },
          "metaData": { "type": "string" },
          "gameId": { "type": "integer" },
          "gameName": { "type": "string" },
          "gameType": { "type": "string" },
          "gameMap": { "type": "integer" },
          "gameMode": { "type": "string" },
          "region": { "type": "string" }
        }
      },
      "TournamentTeamV5": {
        "type": "object",
        "properties": {
          "puuid": { "type": "string", "description": "플레이어의 PUUID (Encrypted)" }
        }
      },
      "LobbyEventV5DTOWrapper": {
        "type": "object",
        "properties": {
          "eventList": { "type": "array", "items": { "$ref": "#/components/schemas/LobbyEventV5DTO" } }
        }
      },
      "LobbyEventV5DTO": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "eventType": { "type": "string" },
          "puuid": { "type": "string" }
        }
      }
    }
  }
}
