{
  "openapi": "3.0.0",
  "info": {
    "title": "Riot API - LOL-RSO-MATCH-V1",
    "version": "1.0.0",
    "description": "리그 오브 레전드 RSO(라이엇 계정 연동) 기반 매치 데이터 API 명세입니다.\nAccess Token 기반으로 플레이어 매치 목록, 개별 매치 상세, 타임라인 데이터를 제공합니다."
  },
  "tags": [
    { "name": "LOL-RSO-MATCH-V1", "description": "LoL RSO Match 관련 API 엔드포인트" }
  ],
  "paths": {
    "/lol/rso-match/v1/matches/ids": {
      "get": {
        "tags": ["LOL-RSO-MATCH-V1"],
        "summary": "플레이어 매치 ID 목록 조회",
        "description": "Access Token(Authorization 헤더)을 이용하여 해당 플레이어의 최근 매치 ID 목록을 조회합니다. 커스텀 매치도 포함됩니다.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Bearer {access_token} 형식의 인증 헤더"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "가져올 매치 ID 개수 (0~100, 기본값 20)"
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "시작 인덱스 (기본값 0)"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "매치 유형 필터 (queue와 함께 사용 가능)"
          },
          {
            "name": "queue",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "큐 ID로 필터링 (예: 420 = 솔로 랭크)"
          },
          {
            "name": "endTime",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "조회 종료 시각 (Epoch 초 단위)"
          },
          {
            "name": "startTime",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "조회 시작 시각 (Epoch 초 단위, 2021-06-16 이후 매치만 지원)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" },
                  "example": ["KR_1234567890", "KR_9876543210"]
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" },
          "502": { "description": "Bad gateway" },
          "503": { "description": "Service unavailable" },
          "504": { "description": "Gateway timeout" }
        }
      }
    },
    "/lol/rso-match/v1/matches/{matchId}": {
      "get": {
        "tags": ["LOL-RSO-MATCH-V1"],
        "summary": "매치 상세 정보 조회",
        "description": "Access Token을 사용해 특정 매치 ID의 상세 정보를 조회합니다.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Bearer {access_token} 형식의 인증 헤더"
          },
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "매치 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchDto" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" },
          "502": { "description": "Bad gateway" },
          "503": { "description": "Service unavailable" },
          "504": { "description": "Gateway timeout" }
        }
      }
    },
    "/lol/rso-match/v1/matches/{matchId}/timeline": {
      "get": {
        "tags": ["LOL-RSO-MATCH-V1"],
        "summary": "매치 타임라인 조회",
        "description": "Access Token을 사용하여 특정 매치의 타임라인 데이터를 조회합니다. (킬/데스/골드/오브젝트 등 시간별 이벤트 포함)",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Bearer {access_token} 형식의 인증 헤더"
          },
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "매치 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimelineDto" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" },
          "502": { "description": "Bad gateway" },
          "503": { "description": "Service unavailable" },
          "504": { "description": "Gateway timeout" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MatchDto": {
        "type": "object",
        "description": "매치 상세 정보 객체 (참가자, 팀, 게임 정보 포함)",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "매치 메타데이터 (matchId, 참가자 PUUID 목록 등)",
            "properties": {
              "matchId": { "type": "string", "description": "매치 ID" },
              "participants": {
                "type": "array",
                "items": { "type": "string" },
                "description": "참가자 PUUID 목록"
              }
            }
          },
          "info": {
            "type": "object",
            "description": "매치 세부 정보",
            "properties": {
              "gameMode": { "type": "string", "description": "게임 모드 (예: CLASSIC, ARAM)" },
              "gameDuration": { "type": "integer", "description": "게임 지속 시간 (초 단위)" },
              "gameStartTimestamp": { "type": "integer", "description": "게임 시작 시각 (epoch ms)" },
              "queueId": { "type": "integer", "description": "큐 ID" },
              "participants": {
                "type": "array",
                "description": "참가자 상세 정보",
                "items": { "type": "object" }
              },
              "teams": {
                "type": "array",
                "description": "팀 정보 (블루/레드 팀)",
                "items": { "type": "object" }
              }
            }
          }
        }
      },
      "TimelineDto": {
        "type": "object",
        "description": "매치 타임라인 데이터 객체",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "타임라인 메타데이터 (matchId, 참가자 PUUID 목록)"
          },
          "info": {
            "type": "object",
            "description": "프레임 단위의 이벤트 정보 (킬, 오브젝트, 골드, 위치 등)",
            "properties": {
              "frames": {
                "type": "array",
                "items": { "type": "object" },
                "description": "시간별 프레임 데이터 배열"
              },
              "frameInterval": { "type": "integer", "description": "프레임 간격 (ms)" }
            }
          }
        }
      }
    }
  }
}
