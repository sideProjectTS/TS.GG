{
  "openapi": "3.0.0",
  "info": {
    "title": "Riot API - LOL-MATCH-V5",
    "version": "1.0.0",
    "description": "리그 오브 레전드 매치 기록 조회 API 명세입니다.\nPUUID를 기준으로 매치 ID 목록, 매치 상세, 타임라인 정보를 제공합니다."
  },
  "tags": [
    { "name": "LOL-MATCH-V5", "description": "LoL 매치 데이터 조회용 API" }
  ],
  "paths": {
    "/lol/match/v5/matches/by-puuid/{puuid}/ids": {
      "get": {
        "tags": ["LOL-MATCH-V5"],
        "summary": "PUUID 기준 매치 ID 목록 조회",
        "description": "플레이어의 PUUID를 기준으로 최근 매치 ID 목록을 조회합니다.",
        "parameters": [
          { "name": "puuid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "플레이어의 PUUID" },
          { "name": "startTime", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "조회 시작 시각 (Epoch 초)" },
          { "name": "endTime", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "조회 종료 시각 (Epoch 초)" },
          { "name": "queue", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "큐 ID 필터 (예: 420 = 솔로랭크)" },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" }, "description": "매치 유형 필터 (예: ranked, normal)" },
          { "name": "start", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 }, "description": "시작 인덱스 (기본값 0)" },
          { "name": "count", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 }, "description": "가져올 매치 개수 (0~100)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/match/v5/matches/{matchId}": {
      "get": {
        "tags": ["LOL-MATCH-V5"],
        "summary": "매치 상세 정보 조회",
        "description": "매치 ID를 기반으로 상세 데이터를 조회합니다. 참가자, 팀, 챔피언, 피해량 등 다양한 정보가 포함됩니다.",
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "매치 ID (예: KR_1234567890)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatchDto" } } }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/lol/match/v5/matches/{matchId}/timeline": {
      "get": {
        "tags": ["LOL-MATCH-V5"],
        "summary": "매치 타임라인 조회",
        "description": "매치의 시간 단위 이벤트 데이터(프레임, 킬, 오브젝트, 위치 등)를 조회합니다.",
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "매치 ID (예: KR_1234567890)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TimelineDto" } } }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "429": { "description": "Rate limit exceeded" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MatchDto": {
        "type": "object",
        "description": "매치 상세 데이터 객체",
        "properties": {
          "metadata": { "$ref": "#/components/schemas/MetadataDto" },
          "info": { "$ref": "#/components/schemas/InfoDto" }
        }
      },
      "MetadataDto": {
        "type": "object",
        "description": "매치 메타데이터",
        "properties": {
          "dataVersion": { "type": "string", "description": "데이터 버전" },
          "matchId": { "type": "string", "description": "매치 ID" },
          "participants": {
            "type": "array",
            "items": { "type": "string" },
            "description": "참가자 PUUID 목록"
          }
        }
      },
      "InfoDto": {
        "type": "object",
        "description": "매치 세부 정보",
        "properties": {
          "gameId": { "type": "integer", "description": "게임 ID" },
          "gameMode": { "type": "string", "description": "게임 모드 (예: CLASSIC, ARAM)" },
          "gameVersion": { "type": "string", "description": "게임 버전" },
          "mapId": { "type": "integer", "description": "맵 ID" },
          "participants": {
            "type": "array",
            "description": "참가자 목록",
            "items": { "$ref": "#/components/schemas/ParticipantDto" }
          },
          "teams": {
            "type": "array",
            "description": "팀 정보",
            "items": { "$ref": "#/components/schemas/TeamDto" }
          }
        }
      },
      "ParticipantDto": {
        "type": "object",
        "description": "참가자별 매치 상세 데이터",
        "properties": {
          "puuid": { "type": "string", "description": "플레이어 PUUID" },
          "summonerName": { "type": "string", "description": "소환사 이름" },
          "championName": { "type": "string", "description": "플레이한 챔피언" },
          "teamId": { "type": "integer", "description": "팀 ID (100 = 블루, 200 = 레드)" },
          "kills": { "type": "integer", "description": "킬 수" },
          "deaths": { "type": "integer", "description": "데스 수" },
          "assists": { "type": "integer", "description": "어시스트 수" },
          "totalDamageDealtToChampions": { "type": "integer", "description": "챔피언에게 가한 총 피해량" },
          "visionScore": { "type": "integer", "description": "시야 점수" },
          "win": { "type": "boolean", "description": "승리 여부" }
        }
      },
      "TeamDto": {
        "type": "object",
        "description": "팀 단위 정보",
        "properties": {
          "teamId": { "type": "integer", "description": "팀 ID" },
          "win": { "type": "boolean", "description": "팀 승리 여부" },
          "bans": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BanDto" },
            "description": "밴 정보 목록"
          }
        }
      },
      "BanDto": {
        "type": "object",
        "properties": {
          "championId": { "type": "integer", "description": "밴된 챔피언 ID" },
          "pickTurn": { "type": "integer", "description": "밴 순서" }
        }
      },
      "TimelineDto": {
        "type": "object",
        "description": "매치 타임라인 전체 데이터 (프레임 단위 이벤트 및 참가자 상태 포함)",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/MetadataDto"
          },
          "info": {
            "type": "object",
            "description": "타임라인 세부 정보 (프레임 단위 데이터)",
            "properties": {
              "frameInterval": {
                "type": "integer",
                "description": "프레임 간격 (밀리초 단위, 일반적으로 60000 = 1분)"
              },
              "frames": {
                "type": "array",
                "description": "시간별 프레임 데이터 배열 (초 단위 스냅샷)",
                "items": { "$ref": "#/components/schemas/MatchTimelineFrameDto" }
              },
              "gameId": {
                "type": "integer",
                "description": "해당 타임라인이 속한 게임 ID"
              }
            }
          }
        }
      },
      "MatchTimelineFrameDto": {
        "type": "object",
        "description": "게임 타임라인의 프레임 단위 데이터 (약 1초 간격 스냅샷)",
        "properties": {
          "timestamp": {
            "type": "integer",
            "description": "해당 프레임의 게임 시간 (밀리초 단위, 예: 60000 = 60초)"
          },
          "events": {
            "type": "array",
            "description": "이 프레임 동안 발생한 모든 이벤트 로그 목록",
            "items": { "$ref": "#/components/schemas/MatchEventDto" }
          },
          "participantFrames": {
            "type": "object",
            "description": "각 참가자(1~10)의 상태 스냅샷",
            "additionalProperties": { "$ref": "#/components/schemas/ParticipantFrameDto" }
          }
        }
      },
      "MatchEventDto": {
        "type": "object",
        "description": "게임 중 발생한 개별 이벤트 데이터 (아이템 구매, 챔피언 처치, 구조물 파괴 등)",
        "properties": {
          "timestamp": { "type": "integer", "description": "이벤트 발생 시각 (게임 내 시간, 밀리초 단위)" },
          "realTimestamp": { "type": "integer", "description": "이벤트 발생 실제 서버 시각 (Unix Time 밀리초)" },
          "type": { "type": "string", "description": "이벤트 유형 (예: ITEM_PURCHASED, CHAMPION_KILL, SKILL_LEVEL_UP)" },
          "participantId": { "type": "integer", "description": "이벤트 주체 참가자 ID (1~10)" },
          "itemId": { "type": "integer", "description": "아이템 관련 이벤트 시 아이템 ID" },
          "creatorId": { "type": "integer", "description": "객체 생성자 ID (와드 설치자, 트랩 소환자 등)" },
          "wardType": { "type": "string", "description": "와드 종류 (YELLOW_TRINKET, CONTROL_WARD 등)" },
          "buildingType": { "type": "string", "description": "구조물 종류 (TOWER_BUILDING, INHIBITOR_BUILDING 등)" },
          "towerType": { "type": "string", "description": "탑 세부 종류 (OUTER_TURRET, BASE_TURRET 등)" },
          "monsterType": { "type": "string", "description": "몬스터 종류 (DRAGON, BARON_NASHOR 등)" },
          "monsterSubType": { "type": "string", "description": "몬스터 세부 종류 (AIR_DRAGON, CHEMTECH_DRAGON 등)" },
          "position": {
            "type": "object",
            "description": "이벤트 발생 좌표 (맵 내 x,y 위치)",
            "properties": {
              "x": { "type": "integer", "description": "X 좌표" },
              "y": { "type": "integer", "description": "Y 좌표" }
            }
          },
          "killerId": { "type": "integer", "description": "가해자 참가자 ID (킬 이벤트 시)" },
          "victimId": { "type": "integer", "description": "피해자 참가자 ID (킬 이벤트 시)" },
          "assistingParticipantIds": {
            "type": "array",
            "description": "어시스트한 참가자 ID 목록",
            "items": { "type": "integer" }
          },
          "skillSlot": { "type": "integer", "description": "스킬 업그레이드 슬롯 번호 (1~5)" },
          "levelUpType": { "type": "string", "description": "레벨업 유형 (NORMAL, EVOLVE, ULTIMATE 등)" },
          "bounty": { "type": "integer", "description": "이벤트로 획득한 현상금 (골드 단위)" },
          "shutdownBounty": { "type": "integer", "description": "셧다운 추가 보상 골드" },
          "multiKillLength": { "type": "integer", "description": "멀티킬 연속 카운트 (더블킬=2 등)" },
          "killerTeamId": { "type": "integer", "description": "이벤트 가해자 팀 ID (100=블루, 200=레드)" },
          "victimTeamId": { "type": "integer", "description": "이벤트 피해자 팀 ID (100=블루, 200=레드)" },
          "gameId": { "type": "integer", "description": "이벤트가 발생한 게임 ID" }
        }
      },
      "ParticipantFrameDto": {
        "type": "object",
        "description": "특정 프레임 시점에서 한 참가자의 상태 데이터",
        "properties": {
          "participantId": { "type": "integer", "description": "참가자 ID (1~10)" },
          "position": {
            "type": "object",
            "description": "현재 위치 좌표 (맵 내 x,y 위치)",
            "properties": {
              "x": { "type": "integer", "description": "X 좌표" },
              "y": { "type": "integer", "description": "Y 좌표" }
            }
          },
          "level": { "type": "integer", "description": "현재 챔피언 레벨" },
          "xp": { "type": "integer", "description": "누적 경험치" },
          "currentGold": { "type": "integer", "description": "현재 보유 골드" },
          "totalGold": { "type": "integer", "description": "누적 획득 골드" },
          "goldPerSecond": { "type": "integer", "description": "초당 골드 수급량 (주로 서포트 아이템 효과)" },
          "minionsKilled": { "type": "integer", "description": "라스트힛한 라인 미니언 수" },
          "jungleMinionsKilled": { "type": "integer", "description": "정글 몬스터 처치 수" },
          "timeEnemySpentControlled": { "type": "integer", "description": "적을 제어(CC)한 누적 시간 (밀리초)" },
          "championStats": { "$ref": "#/components/schemas/ChampionStatsDto" },
          "damageStats": { "$ref": "#/components/schemas/DamageStatsDto" }
        }
      },
      "ChampionStatsDto": {
        "type": "object",
        "description": "챔피언 능력치 상세 데이터 (해당 시점 기준)",
        "properties": {
          "abilityHaste": { "type": "integer", "description": "스킬 가속 수치" },
          "abilityPower": { "type": "integer", "description": "주문력" },
          "armor": { "type": "integer", "description": "방어력" },
          "armorPen": { "type": "integer", "description": "방관 수치 (고정)" },
          "armorPenPercent": { "type": "integer", "description": "방관 비율 (%)" },
          "attackDamage": { "type": "integer", "description": "공격력" },
          "attackSpeed": { "type": "integer", "description": "공격 속도 (기본=100)" },
          "bonusArmorPenPercent": { "type": "integer", "description": "추가 방관 비율" },
          "bonusMagicPenPercent": { "type": "integer", "description": "추가 마관 비율" },
          "ccReduction": { "type": "integer", "description": "군중제어 저항 비율" },
          "cooldownReduction": { "type": "integer", "description": "쿨감 (deprecated, abilityHaste로 대체됨)" },
          "health": { "type": "integer", "description": "현재 체력" },
          "healthMax": { "type": "integer", "description": "최대 체력" },
          "healthRegen": { "type": "integer", "description": "체력 재생 (초당)" },
          "lifesteal": { "type": "integer", "description": "물리 흡혈 비율 (%)" },
          "magicPen": { "type": "integer", "description": "마관 수치 (고정)" },
          "magicPenPercent": { "type": "integer", "description": "마관 비율 (%)" },
          "magicResist": { "type": "integer", "description": "마법 저항력" },
          "movementSpeed": { "type": "integer", "description": "이동 속도" },
          "omnivamp": { "type": "integer", "description": "모든 피해 흡혈 비율 (%)" },
          "physicalVamp": { "type": "integer", "description": "물리 피해 흡혈 비율 (%)" },
          "power": { "type": "integer", "description": "현재 자원 (마나, 기력 등)" },
          "powerMax": { "type": "integer", "description": "최대 자원" },
          "powerRegen": { "type": "integer", "description": "자원 재생량 (초당)" },
          "spellVamp": { "type": "integer", "description": "주문 흡혈 비율 (%)" }
        }
      },
      "DamageStatsDto": {
        "type": "object",
        "description": "참가자가 누적한 피해 통계 (이전 프레임 대비 누적)",
        "properties": {
          "magicDamageDone": { "type": "integer", "description": "가한 마법 피해량" },
          "magicDamageDoneToChampions": { "type": "integer", "description": "챔피언에게 가한 마법 피해량" },
          "magicDamageTaken": { "type": "integer", "description": "받은 마법 피해량" },
          "physicalDamageDone": { "type": "integer", "description": "가한 물리 피해량" },
          "physicalDamageDoneToChampions": { "type": "integer", "description": "챔피언에게 가한 물리 피해량" },
          "physicalDamageTaken": { "type": "integer", "description": "받은 물리 피해량" },
          "totalDamageDone": { "type": "integer", "description": "총 가한 피해량 (모든 유형 합)" },
          "totalDamageDoneToChampions": { "type": "integer", "description": "챔피언에게 가한 총 피해량" },
          "totalDamageTaken": { "type": "integer", "description": "받은 총 피해량" },
          "trueDamageDone": { "type": "integer", "description": "가한 고정 피해량" },
          "trueDamageDoneToChampions": { "type": "integer", "description": "챔피언에게 가한 고정 피해량" },
          "trueDamageTaken": { "type": "integer", "description": "받은 고정 피해량" }
        }
      }
    }
  }
}
